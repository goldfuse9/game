{
  "name": "imp-hra",
  "version": "0.3.0",
  "description": "IMP 2 – Temné patro. Pixel-art roguelite, kde hraješ za impa v pekle.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^45.5.0",
